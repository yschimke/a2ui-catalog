{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
  "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
  "components": {
    "Text": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "Text"
        },
        "variant": {
          "type": "string",
          "enum": [
            "h1",
            "h2",
            "h3",
            "h4",
            "h5",
            "caption",
            "body"
          ],
          "default": "body",
          "description": "A hint for the base text style."
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "text": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The text content to display. While simple Markdown formatting is supported (i.e. without HTML, images, or links), utilizing dedicated UI components is generally preferred for a richer and more structured presentation."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        }
      },
      "required": [
        "component",
        "text"
      ],
      "description": "Displays dynamic text."
    },
    "Image": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "Image"
        },
        "fit": {
          "type": "string",
          "enum": [
            "contain",
            "cover",
            "fill",
            "none",
            "scaleDown"
          ],
          "default": "fill",
          "description": "Specifies how the image should be resized to fit its container. This corresponds to the CSS 'object-fit' property."
        },
        "variant": {
          "type": "string",
          "enum": [
            "icon",
            "avatar",
            "smallFeature",
            "mediumFeature",
            "largeFeature",
            "header"
          ],
          "default": "mediumFeature",
          "description": "A hint for the image size and style."
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "description": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "Accessibility text for the image."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "url": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The URL of the image to display."
        }
      },
      "required": [
        "component",
        "url"
      ],
      "description": "Displays an image from a URL."
    },
    "Icon": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "Icon"
        },
        "name": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "accountCircle",
                "add",
                "arrowBack",
                "arrowForward",
                "attachFile",
                "calendarToday",
                "call",
                "camera",
                "check",
                "close",
                "delete",
                "download",
                "edit",
                "error",
                "event",
                "fastForward",
                "favorite",
                "favoriteOff",
                "folder",
                "help",
                "home",
                "info",
                "locationOn",
                "lock",
                "lockOpen",
                "mail",
                "menu",
                "moreHoriz",
                "moreVert",
                "notifications",
                "notificationsOff",
                "pause",
                "payment",
                "person",
                "phone",
                "photo",
                "play",
                "print",
                "refresh",
                "rewind",
                "search",
                "send",
                "settings",
                "share",
                "shoppingCart",
                "skipNext",
                "skipPrevious",
                "star",
                "starHalf",
                "starOff",
                "stop",
                "upload",
                "visibility",
                "visibilityOff",
                "volumeDown",
                "volumeMute",
                "volumeOff",
                "volumeUp",
                "warning"
              ]
            },
            {
              "type": "object",
              "properties": {
                "svgPath": {
                  "type": "string"
                }
              },
              "required": [
                "svgPath"
              ],
              "additionalProperties": false
            },
            {
              "$ref": "common_types.json#/$defs/DataBinding"
            }
          ],
          "description": "The name of the icon to display."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        }
      },
      "required": [
        "component",
        "name"
      ],
      "description": "Displays an icon from a predefined set of icons or an SVG path."
    },
    "Video": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "Video"
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "url": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The URL of the video to display."
        }
      },
      "required": [
        "component",
        "url"
      ],
      "description": "Displays a video from a URL."
    },
    "AudioPlayer": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "AudioPlayer"
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "description": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "A description of the audio, such as a title or summary."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "url": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The URL of the audio to be played."
        }
      },
      "required": [
        "component",
        "url"
      ],
      "description": "A player for audio content from a URL."
    },
    "Row": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "Row"
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "default": "start",
          "description": "Defines the alignment of children along the cross axis (vertically). This is similar to the CSS 'align-items' property, but uses camelCase values (e.g., 'start')."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList",
          "description": "Defines the children. Use an array of strings for a fixed set of children, or a template object to generate children from a data list. Children cannot be defined inline, they must be referred to by ID."
        },
        "justify": {
          "type": "string",
          "enum": [
            "center",
            "end",
            "spaceAround",
            "spaceBetween",
            "spaceEvenly",
            "start",
            "stretch"
          ],
          "default": "start",
          "description": "Defines the arrangement of children along the main axis (horizontally). Use 'spaceBetween' to push items to the edges, or 'start'/'end'/'center' to pack them together."
        }
      },
      "required": [
        "component",
        "children"
      ],
      "description": "A layout component that arranges its children horizontally. To create a grid layout, nest Columns within this Row."
    },
    "Column": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "Column"
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "align": {
          "type": "string",
          "enum": [
            "center",
            "end",
            "start",
            "stretch"
          ],
          "default": "start",
          "description": "Defines the alignment of children along the cross axis (horizontally). This is similar to the CSS 'align-items' property."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList",
          "description": "Defines the children. Use an array of strings for a fixed set of children, or a template object to generate children from a data list. Children cannot be defined inline, they must be referred to by ID."
        },
        "justify": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "spaceBetween",
            "spaceAround",
            "spaceEvenly",
            "stretch"
          ],
          "default": "start",
          "description": "Defines the arrangement of children along the main axis (vertically). Use 'spaceBetween' to push items to the edges (e.g. header at top, footer at bottom), or 'start'/'end'/'center' to pack them together."
        }
      },
      "required": [
        "component",
        "children"
      ],
      "description": "A layout component that arranges its children vertically. To create a grid layout, nest Rows within this Column."
    },
    "List": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "List"
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "align": {
          "type": "string",
          "enum": [
            "start",
            "center",
            "end",
            "stretch"
          ],
          "default": "stretch",
          "description": "Defines the alignment of children along the cross axis."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList",
          "description": "Defines the children. Use an array of strings for a fixed set of children, or a template object to generate children from a data list."
        },
        "direction": {
          "type": "string",
          "enum": [
            "vertical",
            "horizontal"
          ],
          "default": "vertical",
          "description": "The direction in which the list items are laid out."
        }
      },
      "required": [
        "component",
        "children"
      ],
      "description": "A scrollable list of components laid out vertically or horizontally."
    },
    "Card": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "Card"
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "child": {
          "$ref": "common_types.json#/$defs/ComponentId",
          "description": "The ID of the single child component to be rendered inside the card. To display multiple elements, you MUST wrap them in a layout component (like Column or Row) and pass that container's ID here. Do NOT pass multiple IDs or a non-existent ID."
        }
      },
      "required": [
        "component",
        "child"
      ],
      "description": "A layout component that wraps its child content in a styled card container."
    },
    "Tabs": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "Tabs"
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "$ref": "common_types.json#/$defs/DynamicString",
                "description": "The tab title."
              },
              "child": {
                "$ref": "common_types.json#/$defs/ComponentId",
                "description": "The ID of the child component."
              }
            },
            "required": [
              "title",
              "child"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "An array of objects, where each object defines a tab with a title and a child component."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        }
      },
      "required": [
        "component",
        "tabs"
      ],
      "description": "A set of tabs, each with a title and a corresponding child component."
    },
    "Modal": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "Modal"
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "trigger": {
          "$ref": "common_types.json#/$defs/ComponentId",
          "description": "The ID of the component that opens the modal when interacted with (e.g., a button)."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "content": {
          "$ref": "common_types.json#/$defs/ComponentId",
          "description": "The ID of the component to be displayed inside the modal."
        }
      },
      "required": [
        "component",
        "trigger",
        "content"
      ],
      "description": "A dialog window."
    },
    "Divider": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "Divider"
        },
        "axis": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical"
          ],
          "default": "horizontal",
          "description": "The orientation of the divider."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        }
      },
      "required": [
        "component"
      ],
      "description": "A horizontal or vertical dividing line."
    },
    "Button": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "Button"
        },
        "variant": {
          "type": "string",
          "enum": [
            "default",
            "primary",
            "borderless"
          ],
          "default": "default",
          "description": "A hint for the button style. If omitted, a default button style is used. 'primary' indicates this is the main call-to-action button. 'borderless' means the button has no visual border or background, making its child content appear like a clickable link."
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "action": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "common_types.json#/$defs/CheckRule"
          },
          "description": "A list of checks to perform. These are function calls that must return a boolean indicating validity."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "child": {
          "$ref": "common_types.json#/$defs/ComponentId",
          "description": "The ID of the child component. Use a 'Text' component for a labeled button. Only use an 'Icon' if the requirements explicitly ask for an icon-only button."
        }
      },
      "required": [
        "component",
        "action",
        "child"
      ],
      "description": "A clickable button that dispatches an action."
    },
    "TextField": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "TextField"
        },
        "validationRegexp": {
          "type": "string",
          "description": "A regular expression used for client-side validation of the input."
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "common_types.json#/$defs/CheckRule"
          },
          "description": "A list of checks to perform. These are function calls that must return a boolean indicating validity."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "variant": {
          "type": "string",
          "enum": [
            "longText",
            "number",
            "shortText",
            "obscured"
          ],
          "default": "shortText",
          "description": "The type of input field to display."
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The text label for the input field."
        },
        "value": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The value of the text field."
        }
      },
      "required": [
        "component",
        "label"
      ],
      "description": "A field for user text input."
    },
    "CheckBox": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "CheckBox"
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "common_types.json#/$defs/CheckRule"
          },
          "description": "A list of checks to perform. These are function calls that must return a boolean indicating validity."
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The text to display next to the checkbox."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "value": {
          "$ref": "common_types.json#/$defs/DynamicBoolean",
          "description": "The current state of the checkbox (true for checked, false for unchecked)."
        }
      },
      "required": [
        "component",
        "label",
        "value"
      ],
      "description": "A checkbox with a label and a boolean value."
    },
    "ChoicePicker": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "ChoicePicker"
        },
        "displayStyle": {
          "type": "string",
          "enum": [
            "checkbox",
            "chips"
          ],
          "default": "checkbox",
          "description": "The display style of the component."
        },
        "filterable": {
          "type": "boolean",
          "default": false,
          "description": "If true, displays a search input to filter the options."
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "common_types.json#/$defs/CheckRule"
          },
          "description": "A list of checks to perform. These are function calls that must return a boolean indicating validity."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "variant": {
          "type": "string",
          "enum": [
            "mutuallyExclusive",
            "multipleSelection"
          ],
          "default": "mutuallyExclusive",
          "description": "A hint for how the choice picker should be displayed and behave."
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "$ref": "common_types.json#/$defs/DynamicString",
                "description": "The text to display for this option."
              },
              "value": {
                "type": "string",
                "description": "The stable value associated with this option."
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          },
          "description": "The list of available options to choose from."
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The label for the group of options."
        },
        "value": {
          "$ref": "common_types.json#/$defs/DynamicStringList",
          "description": "The list of currently selected values. This should be bound to a string array in the data model."
        }
      },
      "required": [
        "component",
        "options",
        "value"
      ],
      "description": "A component that allows selecting one or more options from a list."
    },
    "Slider": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "Slider"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "common_types.json#/$defs/CheckRule"
          },
          "description": "A list of checks to perform. These are function calls that must return a boolean indicating validity."
        },
        "min": {
          "type": "number",
          "default": 0,
          "description": "The minimum value of the slider."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "max": {
          "type": "number",
          "description": "The maximum value of the slider."
        },
        "weight": {
          "type": "number",
          "description": "The relative weight of the component within a Row or Column. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        },
        "label": {
          "$ref": "common_types.json#/$defs/DynamicString",
          "description": "The label for the slider."
        },
        "value": {
          "$ref": "common_types.json#/$defs/DynamicNumber",
          "description": "The current value of the slider."
        }
      },
      "required": [
        "component",
        "max",
        "value"
      ],
      "description": "A slider for selecting a numeric value within a range."
    },
    "DateTimeInput": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "const": "DateTimeInput"
        },
        "enableDate": {
          "type": "boolean",
          "default": false,
          "description": "If true, allows the user to select a date."
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "common_types.json#/$defs/CheckRule"
          },
          "description": "A list of checks to perform. These are function calls that must return a boolean indicating validity."
        },
        "min": {
          "allOf": [
            {
              "$ref": "common_types.json#/$defs/DynamicString"
            },
            {
              "if": {
                "type": "string"
              },
              "then": {
                "oneOf": [
                  {
                    "format": "date"
                  },
                  {
                    "format": "time"
                  },
                  {
                    "format": "date-time"
                  }
                ]
              }
            }
          ],
          "description": "The minimum allowed date/time in ISO 8601 format."
        },
        "accessibility": {
          "$ref": "common_types.json#/$defs/AccessibilityAttributes"
        },
        "max": {
          "allOf": [
            {
              "$ref": "common_types.json#/$defs/DynamicString"
            },
            {
              "if": {
                "type": "string"
              },
              "then": {
                "oneOf": [
                  {
                    "format": "date"
                  },
                  {
                    "format": "time"
                  },
                  {
                    "format": "date-time"
                  }
                ]
              }
            }
          ],
          "description": "The maximum allowed date/time in ISO 8601 format."
        },
        "enableTime": {
          "type": "boolean",
          "default": false,
